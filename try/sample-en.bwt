        "s": 0.8
      },
      "conns": [],
      "boxes": [
        {
          "id": 21,
          "type": "text",
          "x": 60,
          "y": 60,
          "w": 340,
          "h": 140,
          "title": "Unused scene",
          "text": "Inside the lighthouse on a rainy day. Two sets of footsteps echoing on the spiral stair. — It fits no chapter, and cannot be thrown away.",
          "vert": false,
          "color": "none",
          "link": null
        },
        {
          "id": 22,
          "type": "text",
          "x": 60,
          "y": 300,
          "w": 340,
          "h": 140,
          "title": "Opening candidates",
          "text": "\"That day, the sea was the color of glass.\"\n\"When the tide goes out, the world is honest exactly once.\"",
          "vert": false,
          "color": "lemon",
          "link": null
        }
      ]
    }
  ]
